# Copy this file to terraform.tfvars and fill in your values

app_name            = "my-org-agenda-api"
git_sync_repository = "git@github.com:yourusername/org-files.git"
git_ssh_private_key = <<-EOT
-----BEGIN OPENSSH PRIVATE KEY-----
your-private-key-here
-----END OPENSSH PRIVATE KEY-----
EOT

# HTTP Basic Auth
auth_user     = "admin"
auth_password = "your-secure-password"

# Optional overrides
# region          = "ord"
# vm_size         = "shared-cpu-1x"
# vm_memory       = 512
# git_sync_interval = 60
# git_user_email  = "org-agenda-api@localhost"
# git_user_name   = "org-agenda-api"

# Custom elisp (optional) - evaluated on startup
# custom_elisp = <<-EOT
#   (setq org-agenda-api-capture-templates
#     '(("todo" :name "Todo" :template ("t" "Todo" entry (file "/data/org/inbox.org") "* TODO %^{Title}\n%U\n%?"))))
# EOT
